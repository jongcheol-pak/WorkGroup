<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinRT(Windows.Management.Deployment, Windows.System.Inventory 등)와 Win32 interop 접근을 위해 Windows 타깃 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkGroup.Application\WorkGroup.Application.csproj" />
    <ProjectReference Include="..\WorkGroup.Domain\WorkGroup.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 순수 internal 로직(MergeApps 등) 단위 테스트 허용 -->
    <InternalsVisibleTo Include="WorkGroup.Application.Tests" />
  </ItemGroup>

</Project>
