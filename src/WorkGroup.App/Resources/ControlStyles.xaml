<?xml version="1.0" encoding="UTF-8" ?>
<!--
    공통 컨트롤 스타일 (WinUI Gallery 카드/버튼 패턴).
    - CardStyle / HeroCardStyle : CardBackgroundFillColorDefault + CardStrokeColorDefault + OverlayCornerRadius.
    - PrimaryActionStyle / SecondaryActionStyle : Accent/Default 버튼 기반.
    - SectionHeaderStyle / SettingsGroupHeaderStyle : 카드/섹션 헤더 표준.
    표준 ThemeResource(브러시·텍스트 스타일·코너반경)만 사용 — 앱 전용 색 정의 없음.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Resources/Spacing.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 카드 — Gallery 표준 카드(LayerFill 위 CardStroke 보더) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="40,40,40,32" />
    </Style>

    <!-- Primary 액션 — AccentButtonStyle 기반 -->
    <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!-- Secondary 액션 — 기본 Button 스타일 -->
    <Style x:Key="SecondaryActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!-- 카드 헤더(BodyStrong 14px SemiBold) -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

    <!-- 설정 그룹 헤더(섹션 제목, 상단 24 / 하단 8 마진) -->
    <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,24,0,8" />
    </Style>

</ResourceDictionary>
