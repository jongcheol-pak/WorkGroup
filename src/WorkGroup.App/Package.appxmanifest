<?xml version="1.0" encoding="UTF-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="JongCheol.8930A247C36"
    Publisher="CN=C4E87E75-D777-4282-B3A5-57BFD2309B52"
    Version="1.0.3.0" />

  <mp:PhoneIdentity PhoneProductId="2428a0be-0c72-42c3-8578-80200f0454e1" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>ms-resource:///Resources/App_DisplayName</DisplayName>
    <PublisherDisplayName>JongCheol</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="ms-resource:///Resources/App_DisplayName"
        Description="ms-resource:///Resources/App_Description"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"  Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- .lnk 타깃으로 쓸 실행 별칭(plan.md D2). 핀된 바로가기가 이 별칭을 호출한다. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="WorkGroup.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- 보조 활성화 경로(plan.md D2): workgroup://group/{id} -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="workgroup" />
        </uap:Extension>
        <!-- 로그인 시 자동 시작(plan.md T12). 기본 활성, 사용자가 토글. -->
        <!-- startupTask 확장의 Executable/EntryPoint 토큰($targetnametoken$ 등)은
             메인 Application 과 달리 패키징 시 치환되지 않으므로 실제 exe 이름과
             full-trust 진입점을 리터럴로 지정해야 MSIX 검증을 통과한다. -->
        <uap5:Extension Category="windows.startupTask"
                        Executable="WorkGroup.App.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WorkGroupStartupTask" Enabled="true" DisplayName="ms-resource:///Resources/App_DisplayName" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
