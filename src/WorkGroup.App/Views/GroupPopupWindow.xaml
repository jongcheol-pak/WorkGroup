<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkGroup.App.Views.GroupPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WorkGroup.App.ViewModels" >

    <!-- 메인 창과 동일하게 창 프레임(Mica 배경 + Windows 11 둥근 모서리/테두리)이 외곽을 담당한다. -->
    <!-- RowSpacing 대신 TitleText Margin으로 간격을 둔다: 헤더 숨김(Collapsed) 시 마진째 사라져 상단 잔여 여백이 없다. -->
    <Grid Padding="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Margin="0,0,0,4" Style="{ThemeResource SubtitleTextBlockStyle}" />

        <GridView Grid.Row="1" x:Name="AppsGrid"
                  ItemsSource="{x:Bind Items, Mode=OneWay}"
                  IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="OnAppClick"
                  CornerRadius="8"
                
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <!-- 마우스 오버/누름 시 항목 배경(GridViewItem 기본 강조)이 보이지 않도록 투명 처리 -->
            <GridView.Resources>
                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            </GridView.Resources>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PopupAppItem">
                    <!-- 마우스 오버 시 아이콘이 살짝 커지는 호버 애니메이션(중앙 기준 스케일) -->
                    <StackPanel Width="48" Height="48"  Spacing="4" Padding="4"
                                HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited">
                        <StackPanel.RenderTransform>
                            <ScaleTransform />
                        </StackPanel.RenderTransform>
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                            <Image HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Window>
