<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkGroup.App.Views.GroupPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:views="using:WorkGroup.App.Views"
    xmlns:vm="using:WorkGroup.App.ViewModels" >

    <!-- 메인 창과 동일하게 창 프레임(Mica 배경 + Windows 11 둥근 모서리/테두리)이 외곽을 담당한다. -->
    <!-- RowSpacing 대신 TitleText Margin으로 간격을 둔다: 헤더 숨김(Collapsed) 시 마진째 사라져 상단 잔여 여백이 없다. -->
    <Grid Padding="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 템플릿/선택기는 부모 스코프에 둔다: GridView 자신의 Resources에 두면 GridView의
             ItemTemplateSelector 속성 설정 시점에 아직 그 Resources가 등록되지 않아 런타임에서 해석 실패한다. -->
        <Grid.Resources>
            <!-- 앱 아이콘 항목 템플릿 -->
            <DataTemplate x:Key="AppItemTemplate" x:DataType="vm:PopupAppItem">
                <!-- 마우스 오버 시 아이콘이 살짝 커지는 호버 애니메이션(중앙 기준 스케일) -->
                <StackPanel Width="48" Height="48"  Spacing="4" Padding="4"
                            HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                            Opacity="{x:Bind IconOpacity, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind DisplayName}"
                            PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited">
                    <StackPanel.RenderTransform>
                        <ScaleTransform />
                    </StackPanel.RenderTransform>
                    <!-- 우클릭 컨텍스트 메뉴: 열기 / 관리자 권한으로 실행(Packaged는 비활성) / 그룹 수정 -->
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{loc:Localize Key=Common_Open}" Tag="{x:Bind}" Click="OnOpenClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{loc:Localize Key=GroupPopup_RunAsAdmin}" Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanRunAsAdmin}" Click="OnRunAsAdminClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7EF;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{loc:Localize Key=GroupPopup_EditGroup}" Click="OnEditGroupClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </StackPanel.ContextFlyout>
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                        <Image HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- "+" 추가(그룹 편집) 버튼 항목 템플릿: 앱 항목과 동일 박스 크기 + 호버 확대, 클릭 시 그룹 편집.
                 루트를 Grid로 둔다: StackPanel(세로)에서는 박스의 VerticalAlignment=Stretch가 무시돼
                 콘텐츠(FontIcon) 높이로 박스가 줄어든다. Grid면 단일 자식이 48×48(패딩 제외 40×40)을 채워 앱 박스와 동일. -->
            <DataTemplate x:Key="AddButtonTemplate" x:DataType="vm:PopupAddButtonItem">
                <Grid Width="48" Height="48" Padding="4"
                      HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                      ToolTipService.ToolTip="{loc:Localize Key=GroupPopup_EditGroup}"
                      PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited">
                    <Grid.RenderTransform>
                        <ScaleTransform />
                    </Grid.RenderTransform>
                    <Grid Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE710;" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- 항목 타입(앱/추가버튼)에 따라 템플릿 선택 -->
            <views:PopupGridItemTemplateSelector x:Key="GridItemSelector"
                                                 AppTemplate="{StaticResource AppItemTemplate}"
                                                 AddButtonTemplate="{StaticResource AddButtonTemplate}" />

            <!-- 작업 표시줄 변에 따라 코드비하인드(_isVertical)에서 GridView.ItemsPanel을 골라 적용한다.
                 상/하 변=가로 1행, 좌/우 변=세로 1열. 둘 다 비가상화 StackPanel(아이콘 수 적어 성능 무관,
                 무한 길이 측정 시 자연 길이를 정확히 보고). -->
            <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
                <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="VerticalItemsPanel">
                <StackPanel Orientation="Vertical" Spacing="4" />
            </ItemsPanelTemplate>

            <!-- GridViewItem 컨테이너 기본 여백(Padding/Margin/MinWidth)을 0으로 없애 아이템 폭을 콘텐츠(48px 박스)로
                 확정한다(여백이 남으면 세로 1열 좁은 폭에서 아이콘이 잘림). 아이템 간격은 ItemsPanel의 Spacing이 담당. -->
            <Style x:Key="PopupItemContainerStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <TextBlock x:Name="TitleText" Margin="0,0,0,4" Style="{ThemeResource SubtitleTextBlockStyle}" />

        <GridView Grid.Row="1" x:Name="AppsGrid"
                  ItemsSource="{x:Bind Items, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource GridItemSelector}"
                  ItemContainerStyle="{StaticResource PopupItemContainerStyle}"
                  IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="OnAppClick"
                  ContainerContentChanging="OnAppsContainerChanging"
                  CornerRadius="8"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- ItemsPanel은 코드비하인드 생성자에서 작업 표시줄 변에 따라
                 HorizontalItemsPanel(상/하) 또는 VerticalItemsPanel(좌/우)로 지정한다. -->
            <GridView.Resources>
                <!-- 마우스 오버/누름 시 항목 배경(GridViewItem 기본 강조)이 보이지 않도록 투명 처리 -->
                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            </GridView.Resources>
        </GridView>
    </Grid>
</Window>
