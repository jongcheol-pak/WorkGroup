<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkGroup.App.Views.GroupPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:views="using:WorkGroup.App.Views"
    xmlns:vm="using:WorkGroup.App.ViewModels" >

    <!-- 메인 창과 동일하게 창 프레임(Mica 배경 + Windows 11 둥근 모서리/테두리)이 외곽을 담당한다. -->
    <!-- RowSpacing 대신 TitleText Margin으로 간격을 둔다: 헤더 숨김(Collapsed) 시 마진째 사라져 상단 잔여 여백이 없다. -->
    <Grid Padding="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 템플릿/선택기는 부모 스코프에 둔다: GridView 자신의 Resources에 두면 GridView의
             ItemTemplateSelector 속성 설정 시점에 아직 그 Resources가 등록되지 않아 런타임에서 해석 실패한다. -->
        <Grid.Resources>
            <!-- 앱 아이콘 항목 템플릿 -->
            <DataTemplate x:Key="AppItemTemplate" x:DataType="vm:PopupAppItem">
                <!-- 마우스 오버 시 아이콘이 살짝 커지는 호버 애니메이션(중앙 기준 스케일) -->
                <StackPanel Width="48" Height="48"  Spacing="4" Padding="4"
                            HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                            ToolTipService.ToolTip="{x:Bind DisplayName}"
                            PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited">
                    <StackPanel.RenderTransform>
                        <ScaleTransform />
                    </StackPanel.RenderTransform>
                    <!-- 우클릭 컨텍스트 메뉴: 열기 / 관리자 권한으로 실행(Packaged는 비활성) / 그룹 수정 -->
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{loc:Localize Key=Common_Open}" Tag="{x:Bind}" Click="OnOpenClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{loc:Localize Key=GroupPopup_RunAsAdmin}" Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanRunAsAdmin}" Click="OnRunAsAdminClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7EF;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{loc:Localize Key=GroupPopup_EditGroup}" Click="OnEditGroupClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </StackPanel.ContextFlyout>
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                        <Image HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- "+" 추가(그룹 편집) 버튼 항목 템플릿: 앱 항목과 동일 박스 구조 + 호버 확대, 클릭 시 그룹 편집 -->
            <DataTemplate x:Key="AddButtonTemplate" x:DataType="vm:PopupAddButtonItem">
                <StackPanel Width="48" Height="48" Spacing="4" Padding="4"
                            HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                            ToolTipService.ToolTip="{loc:Localize Key=GroupPopup_EditGroup}"
                            PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited">
                    <StackPanel.RenderTransform>
                        <ScaleTransform />
                    </StackPanel.RenderTransform>
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE710;" />
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- 항목 타입(앱/추가버튼)에 따라 템플릿 선택 -->
            <views:PopupGridItemTemplateSelector x:Key="GridItemSelector"
                                                 AppTemplate="{StaticResource AppItemTemplate}"
                                                 AddButtonTemplate="{StaticResource AddButtonTemplate}" />
        </Grid.Resources>

        <TextBlock x:Name="TitleText" Margin="0,0,0,4" Style="{ThemeResource SubtitleTextBlockStyle}" />

        <GridView Grid.Row="1" x:Name="AppsGrid"
                  ItemsSource="{x:Bind Items, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource GridItemSelector}"
                  IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="OnAppClick"
                  CornerRadius="8"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- 아이콘을 항상 한 가로줄(1행)로 나열한다(기본 ItemsWrapGrid의 다행 래핑 방지).
                 가상화 ItemsStackPanel은 측정 방향(가로)이 가상화 방향과 같아 무한 너비 측정 시 자연 너비를
                 부정확하게 보고(불필요한 가로 스크롤 발생) → 비가상화 StackPanel로 정확히 측정한다(아이콘 수 적어 성능 무관). -->
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.Resources>
                <!-- 마우스 오버/누름 시 항목 배경(GridViewItem 기본 강조)이 보이지 않도록 투명 처리 -->
                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            </GridView.Resources>
        </GridView>
    </Grid>
</Window>
