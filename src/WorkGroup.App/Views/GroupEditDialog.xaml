<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="WorkGroup.App.Views.GroupEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkGroup.App.ViewModels"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="확인"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid Width="480" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <!-- 1행: 그룹 아이콘 + 이름(15자) -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="IconButton" Width="56" Height="56" Padding="4" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="아이콘 변경">
                <Image Width="40" Height="40" Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />
                <Button.Flyout>
                    <Flyout Opening="OnIconFlyoutOpening">
                        <StackPanel Width="380" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="사용자 아이콘" Click="OnUserIconClick" />
                                <Button Content="리소스 아이콘" Click="OnShowResourceGrid" />
                            </StackPanel>
                            <GridView Visibility="{x:Bind ViewModel.ResourceGridVisibility, Mode=OneWay}" Height="320"
                                      ItemsSource="{x:Bind ViewModel.ResourceIcons, Mode=OneWay}"
                                      SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnResourceIconSelected">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResourceIconItem">
                                        <Border Width="48" Height="48" Padding="4">
                                            <Image Source="{x:Bind Image}" />
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBox Grid.Column="1" Header="그룹 이름" PlaceholderText="이름 입력(최대 15자)"
                     MaxLength="15" VerticalAlignment="Bottom"
                     Text="{x:Bind ViewModel.EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False"
                 Severity="Warning" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- 2행: 앱 추가 -->
        <Button Grid.Row="2" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add" />
                <TextBlock Text="앱 추가" />
            </StackPanel>
            <Button.Flyout>
                <Flyout>
                    <Grid Width="320" Height="380" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox PlaceholderText="앱 검색"
                                 Text="{x:Bind ViewModel.PickerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AvailableApps, Mode=OneWay}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAppPickerItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PopupAppItem">
                                    <Grid ColumnSpacing="10" Padding="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="24" Height="24" VerticalAlignment="Center"
                                               Source="{x:Bind Icon, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- 3행: 선택한 앱 목록 -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.SelectedApps, Mode=OneWay}" SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PopupAppItem">
                    <Grid ColumnSpacing="10" Padding="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="24" Height="24" VerticalAlignment="Center" Source="{x:Bind Icon, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRemoveAppClick"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="삭제">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
