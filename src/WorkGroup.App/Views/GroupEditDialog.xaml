<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="WorkGroup.App.Views.GroupEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkGroup.App.ViewModels"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="확인"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid Width="520" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="320" />
        </Grid.RowDefinitions>

        <!-- 그룹 이름 + 아이콘 설정 + 미리보기 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBox Header="그룹 이름" PlaceholderText="이름 입력"
                         Text="{x:Bind ViewModel.EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Header="아이콘" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.IconOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedIconOption, Mode=TwoWay}"
                          SelectionChanged="OnIconOptionChanged" />
            </StackPanel>
            <Border Grid.Column="1" Width="56" Height="56" VerticalAlignment="Bottom" CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Background="{x:Bind ViewModel.PreviewColor, Mode=OneWay}">
                <Image Width="40" Height="40" Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />
            </Border>
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False"
                 Severity="Warning" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <TextBox Grid.Row="2" PlaceholderText="앱 검색"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="3">
            <ListView ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}" SelectionMode="None"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableAppItem">
                        <Grid ColumnSpacing="10" Padding="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <Image Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center"
                                   Source="{x:Bind Icon, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ContentDialog>
