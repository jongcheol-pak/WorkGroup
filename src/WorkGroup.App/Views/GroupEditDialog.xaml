<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="WorkGroup.App.Views.GroupEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkGroup.App.ViewModels"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="{loc:Localize Key=Common_OK}"
    CloseButtonText="{loc:Localize Key=Common_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid Width="480" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <!-- 1행: 그룹 아이콘 + 이름(15자) -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="IconButton" Width="66" Height="66" Padding="4" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="{loc:Localize Key=GroupEdit_ChangeIconTooltip}">
                <Image Width="50" Height="50" Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />
                <Button.Flyout>
                    <Flyout Opening="OnIconFlyoutOpening">
                        <StackPanel Width="380" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Localize Key=GroupEdit_UserIcon}" Click="OnUserIconClick" />
                                <Button Content="{loc:Localize Key=GroupEdit_ResourceIcon}" Click="OnShowResourceGrid" />
                            </StackPanel>
                            <GridView Visibility="{x:Bind ViewModel.ResourceGridVisibility, Mode=OneWay}" Height="320"
                                      ItemsSource="{x:Bind ViewModel.ResourceIcons, Mode=OneWay}"
                                      SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnResourceIconSelected">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResourceIconItem">
                                        <Border Width="48" Height="48" Padding="4">
                                            <Image Source="{x:Bind Image}" />
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- 이름: 수정 모드는 읽기전용 표시 → 클릭 시 입력창 전환, 신규는 처음부터 입력창 -->
            <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,0">
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.NameDisplayVisibility, Mode=OneWay}">
                    <TextBlock Text="{loc:Localize Key=GroupEdit_NameLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Margin="12,0,0,0" />
                    <!-- 입력창(TextBox)과 동일 높이(40)·세로 중앙 정렬·좌측 인셋(보더1+패딩10=11)을 맞춰 모드 전환 시 위치·크기 고정 -->
                    <Button Click="OnEditNameClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="11,0,6,0"
                            Height="40" VerticalContentAlignment="Center"
                            ToolTipService.ToolTip="{loc:Localize Key=GroupEdit_EditNameTooltip}">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.EditingName, Mode=OneWay}" FontSize="20"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <FontIcon Grid.Column="1" Glyph="&#xE70F;" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
                <!-- 입력창 헤더는 읽기전용 헤더와 동일 스타일로 통일(클릭 시 헤더 크기 변동 방지), 입력 텍스트만 키움 -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.NameEditVisibility, Mode=OneWay}">
                    <TextBlock Text="{loc:Localize Key=GroupEdit_NameLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Margin="12,0,0,0" />
                    <TextBox x:Name="NameTextBox" PlaceholderText="{loc:Localize Key=GroupEdit_NamePlaceholder}" FontSize="20"
                             MaxLength="20" Padding="10,5,0,0"  Height="40" VerticalContentAlignment="Center"
                             Text="{x:Bind ViewModel.EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 이름 변경 시 작업 표시줄 핀 재등록 안내 -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.ShowRenameWarning, Mode=OneWay}" IsClosable="False"
                 Severity="Warning" Message="{loc:Localize Key=GroupEdit_RenameWarning}" />

        <InfoBar Grid.Row="2" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False"
                 Severity="Warning" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- 앱 개수(좌) + 팝업 이름 표시 토글 + 앱 추가 버튼(우) -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.AppCountText, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- 핀 팝업의 그룹 이름 헤더 표시 여부 토글 -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Key=GroupEdit_ShowNameToggle}" VerticalAlignment="Center" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowPopupHeader, Mode=TwoWay}"
                                  MinWidth="0" OnContent="" OffContent="" />
                </StackPanel>

                <!-- 앱 추가: "+" 아이콘만 표시 -->
                <Button ToolTipService.ToolTip="{loc:Localize Key=GroupEdit_AddAppTooltip}">
                    <SymbolIcon Symbol="Add" />
                    <Button.Flyout>
                        <Flyout Opening="OnAppPickerFlyoutOpening">
                            <Grid Width="320" Height="380" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBox PlaceholderText="{loc:Localize Key=GroupEdit_AppSearchPlaceholder}"
                                         Text="{x:Bind ViewModel.PickerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsPickerLoading, Mode=OneWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AvailableApps, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.PickerListVisibility, Mode=OneWay}"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAppPickerItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PopupAppItem">
                                            <Grid ColumnSpacing="10" Padding="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 이미 추가된 항목 체크 표시(고정폭으로 아이콘/이름 정렬 유지) -->
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          Visibility="{x:Bind SelectionGlyphVisibility, Mode=OneWay}" />
                                                <Image Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center"
                                                       Source="{x:Bind Icon, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 선택한 앱 목록 -->
        <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.SelectedApps, Mode=OneWay}" SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PopupAppItem">
                    <!-- 항목 하단 구분선 + 간격으로 행 구분(삭제 버튼 가독성). 선과 콘텐츠는 패딩으로 분리 -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Padding="0,0,0,8" Margin="0,0,0,8">
                        <Grid ColumnSpacing="10" Padding="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="24" Height="24" VerticalAlignment="Center" Source="{x:Bind Icon, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRemoveAppClick"
                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{loc:Localize Key=Common_Delete}">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
