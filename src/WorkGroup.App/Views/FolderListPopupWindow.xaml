<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkGroup.App.Views.FolderListPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 메인 창과 동일하게 창 프레임(Mica 배경 + 둥근 모서리)이 외곽을 담당한다. -->
    <Grid Padding="12,12,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더: "폴더" + 설정(톱니) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="폴더" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Button Grid.Column="1" Click="OnSettingsClick" Background="Transparent" BorderThickness="0"
                    Padding="6" ToolTipService.ToolTip="설정">
                <SymbolIcon Symbol="Setting" />
            </Button>
        </Grid>

        <!-- 폴더 목록(동적 생성: 세로 목록 또는 그리드) -->
        <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FolderPanel" />
        </ScrollViewer>
    </Grid>
</Window>
