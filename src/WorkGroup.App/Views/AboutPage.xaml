<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WorkGroup.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:WorkGroup.App.Services"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PageContentPadding}" HorizontalScrollMode="Disabled">
        <Grid>
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Spacing="4">

            <!-- 페이지 헤더 -->
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="{loc:Localize Key=About_Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{loc:Localize Key=About_Subtitle}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 앱 이름 / 버전 (아이콘을 크게 보이도록 SettingsCard 대신 직접 카드 구성) -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="ms-appx:///Assets/AppIcon.ico"
                           Width="96" Height="96" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.AppName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Version}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- 공식 홈페이지 링크(NavigateUri로 기본 브라우저 실행 — 코드비하인드 불필요) -->
                    <HyperlinkButton Grid.Column="2" VerticalAlignment="Center"
                                     Content="{loc:Localize Key=About_Website}"
                                     NavigateUri="https://jongcheol-pak.github.io/WorkGroup" />
                </Grid>
            </Border>

            <!-- 오픈소스 라이선스 -->
            <TextBlock Text="{loc:Localize Key=About_Licenses_Header}" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Licenses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:LicenseInfo">
                        <!-- 카드 전체 클릭 시 프로젝트 링크로 이동(IsClickEnabled가 우측 > 표시) -->
                        <controls:SettingsCard Header="{x:Bind Name}" Description="{x:Bind License}"
                                               IsClickEnabled="True" Click="OnLicenseClick"
                                               Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
