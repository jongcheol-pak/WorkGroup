<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkGroup.App.Views.SpikePopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel Padding="16" Spacing="8">
            <TextBlock Text="작업 그룹 (spike)" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="GroupIdText" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="이 팝업이 클릭한 아이콘 위 작업 표시줄 변에 표시되면 C2·C3 통과."
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Border>
</Window>
