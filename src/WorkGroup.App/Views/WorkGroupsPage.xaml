<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WorkGroup.App.Views.WorkGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkGroup.App.ViewModels"
    mc:Ignorable="d">

    <!-- 목록이 가용 높이를 채우고 ListView 내부에서 스크롤되도록 ScrollViewer 대신 Grid(행 *)를 쓴다(DG6 변형). -->
    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12"
          MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더: 제목/부제 → 그 아래 줄에 [그룹 개수(좌) · 그룹 추가(우)] -->
        <StackPanel Grid.Row="0" Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=WorkGroups_Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{loc:Localize Key=WorkGroups_Subtitle}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Grid ColumnSpacing="12" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Bottom"
                           Text="{x:Bind ViewModel.GroupCountText, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              
                    <Button Grid.Column="1" Click="OnAddClick" Background="Transparent" BorderThickness="0"
        ToolTipService.ToolTip="{loc:Localize Key=WorkGroups_AddTooltip}">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 메시지가 있을 때만 펼쳐지고(접히면 0높이), 목록과의 간격은 Margin으로 둔다. -->
            <InfoBar Grid.Row="0" Margin="0,0,0,8"
                     Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False"
                     Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <ListView x:Name="GroupsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                      SelectionMode="None"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <!-- 항목을 전체 폭으로 펴고 기본 ListViewItem 패딩 제거 → 카드가 폭을 채우도록 -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupListItem">
                        <!-- 그룹 하나를 개별 카드로 표시. 카드 자체를 드래그해 작업 표시줄에 핀(드래그 비주얼=그룹 아이콘). -->
                        <Border CanDrag="True" DragStarting="OnGroupDragStarting"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 그룹 아이콘(사각 테두리). 내부 영역(50-패딩8-테두리2≈40)에 맞춰 38로 표시(잘림 방지). -->
                                <Border Width="50" Height="50" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{x:Bind IconFallback, Mode=OneWay}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                                    <Image Width="38" Height="38" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                                </Border>

                                <!-- 2라인: 이름 / 멤버 아이콘 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ItemsControl ItemsSource="{x:Bind MemberIcons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PopupAppItem">
                                                    <!-- 멤버 앱 아이콘(사각 테두리 타일, 마우스 오버 시 앱 이름 툴팁) -->
                                                    <Border Width="30" Height="30" CornerRadius="2" Padding="2"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                            ToolTipService.ToolTip="{x:Bind DisplayName}">
                                                        <Image Width="22" Height="22" Source="{x:Bind Icon, Mode=OneWay}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Bind MoreCount, Mode=OneWay}" VerticalAlignment="Center"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 수정/삭제(아이콘 전용) -->
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="OnEditClick"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="{loc:Localize Key=Common_Edit}">
                                    <SymbolIcon Symbol="Edit" />
                                </Button>
                                <Button Grid.Column="3" Tag="{x:Bind}" Click="OnDeleteClick"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="{loc:Localize Key=Common_Delete}">
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 빈 상태 -->
            <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <SymbolIcon Symbol="AllApps" />
                <TextBlock Text="{loc:Localize Key=WorkGroups_Empty}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
