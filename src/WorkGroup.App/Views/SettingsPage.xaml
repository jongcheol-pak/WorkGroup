<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WorkGroup.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PageContentPadding}" HorizontalScrollMode="Disabled">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Spacing="4">

            <!-- 페이지 헤더 -->
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="{loc:Localize Key=Settings_Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{loc:Localize Key=Settings_Subtitle}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Margin="0,0,0,8" />

            <!-- 일반 -->
            <TextBlock Text="{loc:Localize Key=Settings_Section_General}" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <controls:SettingsCard Header="{loc:Localize Key=Settings_AutoStart_Header}"
                                   Description="{loc:Localize Key=Settings_AutoStart_Description}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch OnContent="{loc:Localize Key=Common_On}" OffContent="{loc:Localize Key=Common_Off}"
                              IsOn="{x:Bind ViewModel.AutoStartEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- 모양 -->
            <TextBlock Text="{loc:Localize Key=Settings_Section_Appearance}" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <controls:SettingsCard Header="{loc:Localize Key=Settings_Theme_Header}"
                                   Description="{loc:Localize Key=Settings_Theme_Description}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Localize Key=Settings_Theme_System}" />
                    <ComboBoxItem Content="{loc:Localize Key=Settings_Theme_Light}" />
                    <ComboBoxItem Content="{loc:Localize Key=Settings_Theme_Dark}" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- 언어 -->
            <controls:SettingsCard Header="{loc:Localize Key=Settings_Language_Header}"
                                   Description="{loc:Localize Key=Settings_Language_Description}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF2B7;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Localize Key=Settings_Language_System}" />
                    <ComboBoxItem Content="한국어" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="日本語" />
                    <ComboBoxItem Content="中文(简体)" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- 초기화 -->
            <TextBlock Text="{loc:Localize Key=Settings_Section_Reset}" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <controls:SettingsCard Header="{loc:Localize Key=Settings_Reset_WorkGroups_Header}"
                                   Description="{loc:Localize Key=Settings_Reset_WorkGroups_Description}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="{loc:Localize Key=Common_Reset}" Click="OnResetWorkGroupsClick" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="{loc:Localize Key=Settings_Reset_TrayMenu_Header}"
                                   Description="{loc:Localize Key=Settings_Reset_TrayMenu_Description}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Content="{loc:Localize Key=Common_Reset}" Click="OnResetTrayMenuClick" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
