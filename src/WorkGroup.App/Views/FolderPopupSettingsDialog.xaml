<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="WorkGroup.App.Views.FolderPopupSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{loc:Localize Key=FolderPopup_SettingsTitle}"
    PrimaryButtonText="{loc:Localize Key=Common_Save}"
    CloseButtonText="{loc:Localize Key=Common_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="16" MinWidth="320">
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Localize Key=FolderPopup_ColumnCountLabel}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="ColumnCountCombo" MinWidth="160">
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Columns_1}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Columns_2}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Columns_3}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Columns_4}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Columns_5}" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Localize Key=FolderPopup_DepthLabel}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="DepthCombo" MinWidth="160">
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Depth_1}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Depth_2}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Depth_3}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Depth_4}" />
                <ComboBoxItem Content="{loc:Localize Key=FolderPopup_Depth_5}" />
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <ToggleSwitch x:Name="HiddenToggle" MinWidth="0" OnContent="" OffContent="" />
            <TextBlock Text="{loc:Localize Key=FolderPopup_ShowHidden}" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
