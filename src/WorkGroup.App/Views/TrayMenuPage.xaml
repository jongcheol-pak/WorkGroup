<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WorkGroup.App.Views.TrayMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WorkGroup.App.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkGroup.App.ViewModels"
    mc:Ignorable="d">

    <!-- 목록이 가용 높이를 채우고 ListView 내부에서 스크롤되도록 Grid(행 *)를 쓴다(WorkGroupsPage와 동일). -->
    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12"
          MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더: 제목/안내 → 검색창 → [폴더 개수(좌) · 추가/설정(우)] -->
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=TrayMenu_Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{loc:Localize Key=TrayMenu_Subtitle}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBox x:Name="SearchBox" PlaceholderText="{loc:Localize Key=TrayMenu_SearchPlaceholder}"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="12" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.FolderCountText, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnAddClick" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="{loc:Localize Key=TrayMenu_AddTooltip}">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                    <Button Click="OnSettingsClick" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="{loc:Localize Key=Common_Settings}">
                        <SymbolIcon Symbol="Setting" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 상태 안내 + 폴더 카드 목록 + 빈 상태 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 메시지가 있을 때만 펼쳐지고(접히면 0높이), 목록과의 간격은 Margin으로 둔다. -->
            <InfoBar Grid.Row="0" Margin="0,0,0,8"
                     Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" IsClosable="False"
                     Severity="Error" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <ListView x:Name="FoldersList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                      SelectionMode="None" Background="Transparent"
                      AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop" DragLeave="OnListDragLeave">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderShortcutItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 순서 변경 핸들(작업 그룹 페이지와 같은 조작). 검색 중에는 전체 순서를
                                     확정할 수 없어 숨긴다. 저장 순서가 곧 트레이 팝업의 표시 순서다. -->
                                <FontIcon Glyph="&#xE700;" FontSize="14" VerticalAlignment="Center" Margin="-4,0,-4,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          CanDrag="{x:Bind CanReorder, Mode=OneWay}" DragStarting="OnReorderDragStarting"
                                          Opacity="{x:Bind ReorderHandleOpacity, Mode=OneWay}"
                                          IsHitTestVisible="{x:Bind CanReorder, Mode=OneWay}"
                                          AutomationProperties.AccessibilityView="{x:Bind ReorderHandleAccessibilityView, Mode=OneWay}"
                                          ToolTipService.ToolTip="{loc:Localize Key=Common_ReorderTooltip}" />

                                <!-- 폴더 아이콘(사각 테두리) -->
                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4" VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                                    <Image Width="32" Height="32" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                                </Border>

                                <!-- 2라인: 이름 / 경로 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Path}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- 수정(연필) -->
                                    <Button  Tag="{x:Bind}" Click="OnEditClick"
                               Background="Transparent" BorderThickness="0"
                               ToolTipService.ToolTip="{loc:Localize Key=Common_Edit}">
                                        <SymbolIcon Symbol="Edit" />
                                    </Button>

                                    <!-- 위치 열기 -->
                                    <Button  Tag="{x:Bind}" Click="OnOpenLocationClick"
Background="Transparent" BorderThickness="0"
ToolTipService.ToolTip="{loc:Localize Key=TrayMenu_OpenLocationTooltip}">
                                        <SymbolIcon Symbol="Folder" />
                                    </Button>

                                    <!-- 삭제(휴지통) -->
                                    <Button  Tag="{x:Bind}" Click="OnDeleteClick"
Background="Transparent" BorderThickness="0"
ToolTipService.ToolTip="{loc:Localize Key=Common_Delete}">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </StackPanel>
                               
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 드래그 재정렬 시 끼워 넣을 자리를 알리는 표시선(목록 위에 겹침, 입력은 통과시킨다) -->
            <Rectangle x:Name="DropIndicator" Grid.Row="1" Height="2" Margin="0" RadiusX="1" RadiusY="1"
                       VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       IsHitTestVisible="False" Visibility="Collapsed"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />

            <!-- 빈 상태(등록 폴더 0개) -->
            <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <SymbolIcon Symbol="Folder" />
                <TextBlock Text="{loc:Localize Key=TrayMenu_Empty}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
