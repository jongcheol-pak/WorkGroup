<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WorkGroup.App.Views.TrayMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="트레이 메뉴" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" />
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                 Title="추후 추가 예정"
                 Message="트레이 메뉴 설정 기능은 작업 그룹 기능 완료 후 추가될 예정입니다." />
    </StackPanel>
</Page>
