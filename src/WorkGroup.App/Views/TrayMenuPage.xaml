<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WorkGroup.App.Views.TrayMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WorkGroup.App.ViewModels"
    mc:Ignorable="d">

    <!-- 목록이 가용 높이를 채우고 ListView 내부에서 스크롤되도록 Grid(행 *)를 쓴다(WorkGroupsPage와 동일). -->
    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="12"
          MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더: 제목/안내 → 검색창 → [폴더 개수(좌) · 추가/설정(우)] -->
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="시작" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="트레이 아이콘을 클릭하면 등록된 폴더가 표시됩니다."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBox x:Name="SearchBox" PlaceholderText="폴더 검색..."
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.FolderCountText, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnAddClick" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="폴더 추가">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                    <Button Click="OnSettingsClick" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="설정">
                        <SymbolIcon Symbol="Setting" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 폴더 카드 목록 + 빈 상태 -->
        <Grid Grid.Row="1">
            <ListView x:Name="FoldersList" ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                      SelectionMode="None" Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderShortcutItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 폴더 아이콘(사각 테두리) -->
                                <Border Width="44" Height="44" CornerRadius="4" VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                                    <Image Width="32" Height="32" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                                </Border>

                                <!-- 2라인: 이름 / 경로 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Path}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                </StackPanel>

                                <!-- 수정(연필) -->
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="OnEditClick"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="수정">
                                    <SymbolIcon Symbol="Edit" />
                                </Button>
                                <!-- 더 보기(위치 열기/삭제) -->
                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="더 보기">
                                    <SymbolIcon Symbol="More" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="위치 열기" Tag="{x:Bind}" Click="OnOpenLocationClick">
                                                <MenuFlyoutItem.Icon>
                                                    <SymbolIcon Symbol="Folder" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="삭제" Tag="{x:Bind}" Click="OnDeleteClick">
                                                <MenuFlyoutItem.Icon>
                                                    <SymbolIcon Symbol="Delete" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 빈 상태(등록 폴더 0개) -->
            <StackPanel Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <SymbolIcon Symbol="Folder" />
                <TextBlock Text="등록된 폴더가 없습니다. '+'로 폴더를 추가하세요."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
